# Application
APP_NAME=KLTN API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie (httpOnly cookie giữ access/refresh token)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth — lấy Client ID ở Google Cloud Console (OAuth 2.0 Client, loại Web)
GOOGLE_CLIENT_ID=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Lưu trữ PDF tải lên (gốc be/)
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=25

# OpenAI (embedding tài liệu RAG)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Weaviate Cloud (vector store)
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=DocumentChunk

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Arize Phoenix (tracing) — Phoenix Cloud cần endpoint + api key
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=kltn-rag
