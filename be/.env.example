# Application
APP_NAME=KLTN API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie (httpOnly cookie giữ access/refresh token)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth — lấy Client ID ở Google Cloud Console (OAuth 2.0 Client, loại Web)
GOOGLE_CLIENT_ID=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Lưu trữ PDF tải lên (gốc be/)
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=25

# OpenAI (embedding tài liệu RAG)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Weaviate Cloud (vector store)
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=DocumentChunk

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Reranker — mặc định Cohere API (đa ngữ, 0 RAM). ViRanker local 2.2GB không nạp nổi trên
# máy RAM thấp (segfault) nên dùng API.
#   RERANK_PROVIDER=cohere → cần COHERE_API_KEY (lấy ở dashboard.cohere.com)
#   RERANK_PROVIDER=sentence-transformers → chạy local (cần đủ RAM); đổi RERANK_MODEL=namdp-ptit/ViRanker
RERANK_PROVIDER=cohere
RERANK_MODEL=rerank-multilingual-v3.0
RERANK_TOP_N=6
COHERE_API_KEY=
RAG_TIMEOUT_SECONDS=60

# Chỉ dùng khi RERANK_PROVIDER=sentence-transformers (reranker local):
# RERANK_WARMUP=true (nạp model lúc startup), RERANK_NUM_THREADS, HF_* (cache/offline model).
RERANK_WARMUP=false
RERANK_NUM_THREADS=0
HF_HOME=
HF_TOKEN=
HF_HUB_OFFLINE=0

# Arize Phoenix (tracing) — Phoenix Cloud cần endpoint + api key
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=kltn-rag
